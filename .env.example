# Optional canonical origin, such as https://share.example.com
SPECHUB_SHARE_PUBLIC_URL=

# Added automatically when a private Vercel Blob store is connected.
BLOB_STORE_ID=

# Required for local development outside Vercel OIDC.
BLOB_READ_WRITE_TOKEN=

# Added when an Upstash Redis database is connected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
