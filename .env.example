# Optional canonical origin, such as https://share.example.com
SPECHUB_SHARE_PUBLIC_URL=

# Snapshot backend: vercel-blob (default) or cloudflare-r2
SPECHUB_SHARE_STORAGE=vercel-blob

# Added automatically when a private Vercel Blob store is connected.
BLOB_STORE_ID=

# Required for local development outside Vercel OIDC.
BLOB_READ_WRITE_TOKEN=

# Required when SPECHUB_SHARE_STORAGE=cloudflare-r2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Added when an Upstash Redis database is connected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
